{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "sync-unreleased": "node scripts/sync-unreleased.mjs",
    "version-packages": "node scripts/sync-unreleased.mjs && changeset version && node scripts/rotate-changelog.mjs",
    "release": "turbo run build --filter=@keystoneui/storybook^... --filter=@keystoneui/mcp && changeset publish",
    "preview-storybook": "turbo run preview-storybook",
    "test": "turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "add:component": "node scripts/add-component.mjs",
    "build:skills": "bash scripts/build-skills.sh",
    "registry:sync": "node scripts/sync-registry.mjs",
    "registry:build": "node scripts/sync-registry.mjs && shadcn build -o apps/docs/public/r",
    "lint:docs": "node scripts/lint-component-mdx.mjs && node scripts/lint-block-mdx.mjs && node scripts/lint-stories-vs-demos.mjs",
    "lint:stories-demos": "node scripts/lint-stories-vs-demos.mjs",
    "docs:migrate": "node scripts/migrate-component-mdx.mjs",
    "docs:backlinks": "node scripts/generate-block-backlinks.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "^2.31.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "shadcn": "^4.21.0",
    "turbo": "^2.10.12",
    "ultracite": "7.11.0"
  },
  "packageManager": "pnpm@9.15.0",
  "name": "design-system",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "ultracite fix"
    ]
  }
}
