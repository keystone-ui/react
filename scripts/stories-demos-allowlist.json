{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "_notes": {
    "_strategy": "Baseline seed captured 2026-05. Stories enumerate per-variant (Secondary, Destructive, etc.); demos consolidate (variants.tsx, sizes.tsx). The two surfaces are intentionally separate — see CONTRIBUTING.md and AGENTS.md. This allowlist captures the world as it stands so the lint only fires on NEW drift introduced after this date. Reviewers should challenge new entries during PR review and prefer authoring the missing variant on the other surface when sensible.",
    "_common_patterns": {
      "perVariantStoriesVsConsolidatedDemo": "stories Secondary/Destructive/Ghost/Outline → demo variants.tsx. Story-only by design.",
      "perSizeStoriesVsSizesDemo": "stories Small/Medium/Large → demo sizes.tsx. Story-only by design.",
      "singularStoryVsPluralDemo": "story WithIcon → demo with-icons. Treat as conceptual match; allowlisted on story side.",
      "basicStoryVsDefaultDemo": "story Basic → demo default. Conceptual match; allowlisted."
    }
  },
