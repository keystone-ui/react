{
  "name": "@keystoneui/storybook",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build --stats-json",
    "preview-storybook": "serve storybook-static",
    "clean": "rm -rf .turbo && rm -rf node_modules",
    "test": "vitest",
    "test-storybook": "vitest --project=storybook",
    "chromatic": "chromatic --exit-zero-on-changes --auto-accept-changes=main",
    "deploy:cf": "wrangler pages deploy storybook-static --project-name=keystoneui-storybook"
  },
  "dependencies": {
    "@keystoneui/react": "workspace:*",
    "@remixicon/react": "^4.9.0",
    "chrono-node": "^2.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-data-list": "^1.6.3",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-circle-flags": "^0.0.30",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.14.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@keystoneui/typescript-config": "workspace:*",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-onboarding": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "chromatic": "^18.12.0",
    "playwright": "^1.64.0",
    "serve": "^14.2.6",
    "storybook": "^10.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
