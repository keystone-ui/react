{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "button-group-with-dropdown-menu",
  "title": "Button Group With Dropdown Menu",
  "description": "Button Group example: With Dropdown Menu.",
  "registryDependencies": [
    "button",
    "button-group",
    "dropdown-menu"
  ],
  "files": [
    {
      "path": "apps/docs/demos/button-group/with-dropdown-menu.tsx",
      "content": "\"use client\";\n\nimport { Button } from \"@keystoneui/react/button\";\nimport { ButtonGroup } from \"@keystoneui/react/button-group\";\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuGroup,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from \"@keystoneui/react/dropdown-menu\";\nimport {\n  TriangleAlert as AlertTriangleIcon,\n  Check as CheckIcon,\n  ChevronDown as ChevronDownIcon,\n  GitFork as GitForkIcon,\n  Star as StarIcon,\n  UserRoundX as UserRoundXIcon,\n  VolumeOff as VolumeOffIcon,\n} from \"lucide-react\";\n\nexport default function ButtonGroupWithDropdownMenu() {\n  return (\n    <div className=\"flex flex-wrap items-start gap-8\">\n      <ButtonGroup>\n        <Button variant=\"outline\">\n          <StarIcon /> Star\n        </Button>\n        <Button variant=\"outline\">1.2k</Button>\n      </ButtonGroup>\n\n      <ButtonGroup>\n        <Button variant=\"outline\">\n          <GitForkIcon /> Fork\n        </Button>\n        <Button variant=\"outline\">342</Button>\n      </ButtonGroup>\n\n      <ButtonGroup>\n        <Button variant=\"outline\">\n          <CheckIcon /> Following\n        </Button>\n        <DropdownMenu>\n          <DropdownMenuTrigger\n            render={\n              <Button size=\"icon\" variant=\"outline\">\n                <ChevronDownIcon className=\"size-4\" />\n              </Button>\n            }\n          />\n          <DropdownMenuContent align=\"end\" className=\"w-44\">\n            <DropdownMenuGroup>\n              <DropdownMenuItem>\n                <VolumeOffIcon className=\"size-4\" />\n                Mute Conversation\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <AlertTriangleIcon className=\"size-4\" />\n                Report\n              </DropdownMenuItem>\n              <DropdownMenuItem>\n                <UserRoundXIcon className=\"size-4\" />\n                Block User\n              </DropdownMenuItem>\n            </DropdownMenuGroup>\n          </DropdownMenuContent>\n        </DropdownMenu>\n      </ButtonGroup>\n    </div>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}