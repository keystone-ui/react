    {
      "path": "apps/docs/demos/resizable/nested.tsx",
      "content": "\"use client\";\n\nimport {\n  ResizableHandle,\n  ResizablePanel,\n  ResizablePanelGroup,\n} from \"@keystoneui/react/resizable\";\n\nexport default function ResizableNested() {\n  return (\n    <ResizablePanelGroup\n      className=\"max-w-md rounded-lg border\"\n      orientation=\"horizontal\"\n    >\n      <ResizablePanel defaultSize={50}>\n        <div className=\"flex h-[200px] items-center justify-center p-6\">\n          <span className=\"font-semibold text-sm\">Sidebar</span>\n        </div>\n      </ResizablePanel>\n      <ResizableHandle withHandle />\n      <ResizablePanel defaultSize={50}>\n        <ResizablePanelGroup orientation=\"vertical\">\n          <ResizablePanel defaultSize={30}>\n            <div className=\"flex h-full items-center justify-center p-6\">\n              <span className=\"font-semibold text-sm\">Header</span>\n            </div>\n          </ResizablePanel>\n          <ResizableHandle withHandle />\n          <ResizablePanel defaultSize={70}>\n            <div className=\"flex h-full items-center justify-center p-6\">\n              <span className=\"font-semibold text-sm\">Content</span>\n            </div>\n          </ResizablePanel>\n        </ResizablePanelGroup>\n      </ResizablePanel>\n    </ResizablePanelGroup>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}