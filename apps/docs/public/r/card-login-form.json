{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "card-login-form",
  "title": "Card Login Form",
  "description": "Card example: Login Form.",
  "registryDependencies": [
    "button",
    "card",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "apps/docs/demos/card/login-form.tsx",
      "content": "\"use client\";\n\nimport { Button } from \"@keystoneui/react/button\";\nimport {\n  Card,\n  CardAction,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@keystoneui/react/card\";\nimport { Input } from \"@keystoneui/react/input\";\nimport { Label } from \"@keystoneui/react/label\";\n\nexport default function CardLoginForm() {\n  return (\n    <Card className=\"w-full max-w-sm\">\n      <CardHeader>\n        <CardTitle>Sign in to your account</CardTitle>\n        <CardDescription>\n          Enter your email below to sign in to your account\n        </CardDescription>\n        <CardAction>\n          <Button variant=\"link\">Sign Up</Button>\n        </CardAction>\n      </CardHeader>\n      <CardContent>\n        <form>\n          <div className=\"flex flex-col gap-6\">\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"email\">Email</Label>\n              <Input\n                id=\"email\"\n                placeholder=\"m@example.com\"\n                required\n                type=\"email\"\n              />\n            </div>\n            <div className=\"grid gap-2\">\n              <div className=\"flex items-center\">\n                <Label htmlFor=\"password\">Password</Label>\n                <a\n                  className=\"ml-auto inline-block text-sm underline-offset-4 hover:underline\"\n                  href=\"/forgot-password\"\n                >\n                  Forgot your password?\n                </a>\n              </div>\n              <Input id=\"password\" required type=\"password\" />\n            </div>\n          </div>\n        </form>\n      </CardContent>\n      <CardFooter className=\"flex-col gap-2\">\n        <Button className=\"w-full\" type=\"submit\">\n          Sign in\n        </Button>\n        <Button className=\"w-full\" variant=\"outline\">\n          Sign in with Google\n        </Button>\n      </CardFooter>\n    </Card>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}