{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "field-checkout-form",
  "title": "Field Checkout Form",
  "description": "Field example: Checkout Form.",
  "registryDependencies": [
    "button",
    "checkbox",
    "field",
    "input",
    "select",
    "textarea"
  ],
  "files": [
    {
      "path": "apps/docs/demos/field/checkout-form.tsx",
      "content": "\"use client\";\n\nimport { Button } from \"@keystoneui/react/button\";\nimport { Checkbox } from \"@keystoneui/react/checkbox\";\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n  FieldLegend,\n  FieldSeparator,\n  FieldSet,\n} from \"@keystoneui/react/field\";\nimport { Input } from \"@keystoneui/react/input\";\nimport {\n  Select,\n  SelectContent,\n  SelectGroup,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@keystoneui/react/select\";\nimport { Textarea } from \"@keystoneui/react/textarea\";\n\nexport default function FieldCheckoutForm() {\n  return (\n    <div className=\"w-full max-w-md rounded-xl border p-6\">\n      <form>\n        <FieldGroup>\n          <FieldSet>\n            <FieldLegend>Payment Method</FieldLegend>\n            <FieldDescription>\n              All transactions are secure and encrypted\n            </FieldDescription>\n            <FieldGroup>\n              <Field>\n                <FieldLabel htmlFor=\"checkout-card-name\">\n                  Name on Card\n                </FieldLabel>\n                <Input\n                  id=\"checkout-card-name\"\n                  placeholder=\"John Doe\"\n                  required\n                />\n              </Field>\n              <div className=\"grid grid-cols-3 gap-4\">\n                <Field className=\"col-span-2\">\n                  <FieldLabel htmlFor=\"checkout-card-number\">\n                    Card Number\n                  </FieldLabel>\n                  <Input\n                    id=\"checkout-card-number\"\n                    placeholder=\"1234 5678 9012 3456\"\n                    required\n                  />\n                  <FieldDescription>\n                    Enter your 16-digit number.\n                  </FieldDescription>\n                </Field>\n                <Field className=\"col-span-1\">\n                  <FieldLabel htmlFor=\"checkout-cvv\">CVV</FieldLabel>\n                  <Input id=\"checkout-cvv\" placeholder=\"123\" required />\n                </Field>\n              </div>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <Field>\n                  <FieldLabel htmlFor=\"checkout-exp-month\">Month</FieldLabel>\n                  <Select defaultValue=\"\">\n                    <SelectTrigger id=\"checkout-exp-month\">\n                      <SelectValue placeholder=\"MM\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectGroup>\n                        {Array.from({ length: 12 }, (_, i) => {\n                          const val = String(i + 1).padStart(2, \"0\");\n                          return (\n                            <SelectItem key={val} value={val}>\n                              {val}\n                            </SelectItem>\n                          );\n                        })}\n                      </SelectGroup>\n                    </SelectContent>\n                  </Select>\n                </Field>\n                <Field>\n                  <FieldLabel htmlFor=\"checkout-exp-year\">Year</FieldLabel>\n                  <Select defaultValue=\"\">\n                    <SelectTrigger id=\"checkout-exp-year\">\n                      <SelectValue placeholder=\"YYYY\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectGroup>\n                        {Array.from({ length: 6 }, (_, i) => {\n                          const val = String(2024 + i);\n                          return (\n                            <SelectItem key={val} value={val}>\n                              {val}\n                            </SelectItem>\n                          );\n                        })}\n                      </SelectGroup>\n                    </SelectContent>\n                  </Select>\n                </Field>\n              </div>\n            </FieldGroup>\n          </FieldSet>\n          <FieldSeparator />\n          <FieldSet>\n            <FieldLegend>Billing Address</FieldLegend>\n            <FieldDescription>\n              The billing address associated with your payment method\n            </FieldDescription>\n            <FieldGroup>\n              <Field orientation=\"horizontal\">\n                <Checkbox defaultChecked id=\"checkout-same-as-shipping\" />\n                <FieldLabel\n                  className=\"font-normal\"\n                  htmlFor=\"checkout-same-as-shipping\"\n                >\n                  Same as shipping address\n                </FieldLabel>\n              </Field>\n            </FieldGroup>\n          </FieldSet>\n          <FieldSeparator />\n          <FieldSet>\n            <FieldGroup>\n              <Field>\n                <FieldLabel htmlFor=\"checkout-comments\">Comments</FieldLabel>\n                <Textarea\n                  id=\"checkout-comments\"\n                  placeholder=\"Add any additional comments\"\n                />\n              </Field>\n            </FieldGroup>\n          </FieldSet>\n          <Field orientation=\"horizontal\">\n            <Button type=\"submit\">Submit</Button>\n            <Button type=\"button\" variant=\"outline\">\n              Cancel\n            </Button>\n          </Field>\n        </FieldGroup>\n      </form>\n    </div>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}