{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-default",
  "title": "Popover Default",
  "description": "Popover example: Default.",
  "registryDependencies": [
    "button",
    "popover"
  ],
  "files": [
    {
      "path": "apps/docs/demos/popover/default.tsx",
      "content": "\"use client\";\n\nimport { Button } from \"@keystoneui/react/button\";\nimport {\n  Popover,\n  PopoverContent,\n  PopoverDescription,\n  PopoverHeader,\n  PopoverTitle,\n  PopoverTrigger,\n} from \"@keystoneui/react/popover\";\n\nexport default function PopoverDefault() {\n  return (\n    <Popover>\n      <PopoverTrigger render={<Button variant=\"outline\" />}>\n        Open Popover\n      </PopoverTrigger>\n      <PopoverContent>\n        <PopoverHeader>\n          <PopoverTitle>Dimensions</PopoverTitle>\n          <PopoverDescription>\n            Set the dimensions for the layer.\n          </PopoverDescription>\n        </PopoverHeader>\n        <div className=\"grid gap-2\">\n          <div className=\"grid grid-cols-3 items-center gap-4\">\n            <span className=\"text-sm\">Width</span>\n            <span className=\"col-span-2 text-muted-foreground text-sm\">\n              100%\n            </span>\n          </div>\n          <div className=\"grid grid-cols-3 items-center gap-4\">\n            <span className=\"text-sm\">Height</span>\n            <span className=\"col-span-2 text-muted-foreground text-sm\">\n              25px\n            </span>\n          </div>\n        </div>\n      </PopoverContent>\n    </Popover>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}