{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "keystoneui-docs",
  // Keep this a few days in the past: the Cloudflare API rejects a date that
  // is in the future for its own clock, and CI runs in UTC.
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Don't upload the source map: it embeds the adapter's already-minified
  // server bundle, so it never maps a frame to repository source, and its
  // size counts against the 60 MiB source-map limit, which refuses the deploy.
  "upload_source_maps": false,
  // Keep Workers Logs so an uncaught exception in the server function is
  // visible; the smoke test's failure message points operators here.
  "observability": {
    "enabled": true
  }
}
